# Copy this file to .env and fill in your values. Never commit .env.

# Zerodha Kite Connect app credentials (https://developers.kite.trade)
# Live quotes need the paid "Kite Connect" plan.
# In your Kite app, set the Redirect URL to: http://127.0.0.1:5173/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Set to 1 to use simulated prices instead of Kite (no API key needed)
KITE_MOCK=0

# Server
PORT=5173
HOST=127.0.0.1
DATA_DIR=data
